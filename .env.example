# Server-only Supabase project URL and privileged key.
SUPABASE_URL=https://your-project.supabase.co

# Server-only database credential used by Route Handlers. Keep it out of client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set both to long random values (at least 32 bytes); never commit real values.
COOKIE_SIGNING_SECRET=replace-with-a-long-random-secret
ADMIN_ACCESS_CODE=replace-with-an-admin-access-code
